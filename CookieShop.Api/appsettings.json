{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=cookie_shop"
  },
  "JwtSettings": {
    "Issuer": "CookieShopAPI",
    "Audience": "CookieShopClient",
    "ExpirationMinutes": 60,
    "SecretKey": "SuperCriticalAwesomeKeyOfMyDevServerCookieShop"
  },
  "CorsSettings": {
    "DevelopmentOrigin": "http://localhost:4200",
    "ProductionOrigin": "https://cookieshop.com"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "BootstrapAdmin": {
    "Enabled": false
  },
  "Media": {
    "Provider": "Postgres"
  }
}
